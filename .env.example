VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Web push (Firebase Cloud Messaging) — from Firebase Console > Project settings > Cloud Messaging > Web configuration
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Comma-separated emails that can access /admin/support
VITE_SUPPORT_ADMIN_EMAILS=ulysis@ubb-global.com,johncarlobilbao03@gmail.com

# Cloud Functions — also set in functions/.env (loaded on deploy)
SUPPORT_ADMIN_EMAILS=ulysis@ubb-global.com,johncarlobilbao03@gmail.com

# PayMongo — set these in functions/.env (see functions/.env.example for full test setup)
# Never prefix PayMongo keys with VITE_ (server-side only)

# Local dev: route callable functions to the emulator (requires firebase emulators:start --only functions)
VITE_USE_FUNCTIONS_EMULATOR=false
