# Copy to functions/.env and fill in values (never commit functions/.env)
# Loaded automatically on: firebase deploy --only functions

SUPPORT_ADMIN_EMAILS=your-admin@example.com

# --- PayMongo test mode (no real charges) ---
# 1. Sign up: https://dashboard.paymongo.com
# 2. Developers → API Keys → copy Secret Test Key (sk_test_...)
# 3. Enable payment methods: Settings → Payment Methods (card, GCash, Maya)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# Optional for checkout-only testing. Required to auto-mark permits as paid.
# Settings → Webhooks → Add endpoint → checkout_session.payment.paid
# URL: https://philtax.web.app/api/paymongo/webhook
#   or: https://asia-southeast1-philtax.cloudfunctions.net/paymongoWebhook
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Where PayMongo redirects after pay/cancel (must match your dev or prod URL)
APP_ORIGIN=http://localhost:5173
