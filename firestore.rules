rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matches auth.uid)
// Fields:
//   - email: string (required) - account email
//   - displayName: string (required) - display name from auth
//   - fullName: string (optional) - legal full name
//   - tin: string (optional) - taxpayer identification number
//   - businessName: string (optional) - registered business name
//   - taxType: string (optional) - taxpayer classification
//   - rdo: string (optional) - revenue district office
//   - createdAt: timestamp (required, immutable after create)
//   - updatedAt: timestamp (required)
//
// Subcollection: users/{userId}/transactions/{transactionId}
// Fields:
//   - type: string (required) - "income" or "expense"
//   - description: string (required, 1-500 chars)
//   - amount: number (required, > 0)
//   - date: string (required) - ISO date YYYY-MM-DD
//   - category: string (required, 1-100 chars)
//   - reference: string (optional, max 100 chars)
//   - createdAt: timestamp (required, immutable)
//
// Subcollection: users/{userId}/deadlines/{deadlineId}
// Fields:
//   - formType: string (required) - BIR form type
//   - title: string (required, 1-200 chars)
//   - dueDate: string (required) - ISO date
//   - amountDue: number (required, >= 0)
//   - status: string (required) - upcoming | due_soon | overdue | filed
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
//
// Subcollection: users/{userId}/permits/{permitId}
// Fields:
//   - businessName, lgu, permitType (new|renewal), year, amount, status
//   - paymentId, createdAt, updatedAt
//   - Client read-only; writes via Cloud Functions Admin SDK
//
// Subcollection: users/{userId}/payments/{paymentId}
// Fields:
//   - permitId, amount, amountCentavos, currency, status, channel?
//   - paymongoCheckoutId, paymongoPaymentId?, referenceNumber, paidAt?
//   - createdAt, updatedAt
//   - Client read-only; writes via Cloud Functions Admin SDK
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isSupportAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.admin == true;
    }

    // Company codes identify a company; only a verified, active membership
    // grants access. Server transactions create and maintain these records.
    function isCompanyMember(companyId) {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid)).data.role in ['admin', 'manager', 'accountant', 'viewer'];
    }

    function isCompanyPreparer(companyId) {
      return isCompanyMember(companyId)
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid)).data.role in ['admin', 'manager', 'accountant'];
    }

    match /consultations/{requestId} {
      allow read: if isSupportAdmin() || isVerifiedOwner(resource.data.ownerUid);
      allow write: if false;
      match /history/{eventId} {
        allow read: if isSupportAdmin() || isVerifiedOwner(get(/databases/$(database)/documents/consultations/$(requestId)).data.ownerUid);
        allow write: if false;
      }
    }
    match /consultationLimits/{userId} { allow read, write: if false; }
    match /regulatoryUpdates/{id} {
      allow read: if isAuthenticated() && request.auth.token.email_verified == true;
      allow write: if false;
    }
    match /regulatorySync/{id} {
      allow read: if isAuthenticated() && request.auth.token.email_verified == true;
      allow write: if false;
    }

    match /companyMemberships/{userId} {
      // An inactive member can see their own access status, not company data.
      allow get: if isVerifiedOwner(userId);
      allow list, create, update, delete: if false;
    }

    match /companyCodes/{code} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list, create, update, delete: if false;

      match /accounting/{documentId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }
      match /members/{userId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }
      match /approvals/{approvalId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }
      match /audit/{eventId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }
      match /invitations/{tokenHash} {
        allow read, write: if false;
      }
      match /parties/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /partyTinIndex/{id} { allow read, write: if false; }
      match /regulations/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /complianceTasks/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /taxMappings/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /taxTemplates/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /taxRegisters/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /taxDrafts/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /employees/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /payrollRuns/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /assets/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /assetRuns/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /assetControl/{id} { allow read: if isCompanyMember(companyId); allow write: if false; }
      match /bankAccounts/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /bankStatements/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /bankStatementVersions/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /bankAdjustments/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /paymentRequests/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /paymentRequestVersions/{id} { allow read: if isCompanyPreparer(companyId); allow write: if false; }
      match /paymentControl/{id} { allow read, write: if false; }
      match /bankControl/{id} { allow read, write: if false; }
      match /bankStatementImports/{id} { allow read, write: if false; }
      match /bankRowIndex/{id} { allow read, write: if false; }
    }

    function isValidTimestamp(field) {
      return field is timestamp;
    }

    function optionalString(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLen);
    }

    function isValidUserProfileCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt)
        && optionalString('fullName', 120)
        && optionalString('tin', 20)
        && optionalString('businessName', 200)
        && optionalString('taxType', 120)
        && optionalString('rdo', 120);
    }

    function isValidUserProfileUpdate() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt)
        && data.createdAt == resource.data.createdAt
        && optionalString('fullName', 120)
        && optionalString('tin', 20)
        && optionalString('businessName', 200)
        && optionalString('taxType', 120)
        && optionalString('rdo', 120);
    }

    function isTrackingDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function optionalTrackingDate(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == ''
        || isTrackingDate(request.resource.data[field]);
    }

    function optionalTrackingUrl(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= 1000
          && (request.resource.data[field] == ''
            || (request.resource.data[field].matches('^https?://[^\\s]+$')
              && !request.resource.data[field].matches('^https?://[^/]*@.*'))));
    }

    function isValidTransaction() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'type', 'description', 'amount', 'date', 'category', 'createdAt',
        ])
        && data.type in ['income', 'expense']
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 500
        && data.amount is number
        && data.amount > 0
        && data.amount <= 10000000000
        && isTrackingDate(data.date)
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 100
        && isValidTimestamp(data.createdAt)
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt))
        && optionalString('reference', 100);
    }

    function isValidTransactionCreate() {
      return isValidTransaction()
        && request.resource.data.keys().hasOnly([
          'type', 'description', 'amount', 'date', 'category', 'reference', 'createdAt', 'updatedAt',
        ]);
    }

    function isValidTransactionUpdate() {
      return isValidTransaction()
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTimestamp(request.resource.data.updatedAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'description', 'amount', 'date', 'category', 'reference', 'updatedAt',
        ]);
    }

    function isValidDeadline() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'formType', 'title', 'dueDate', 'amountDue', 'status', 'createdAt', 'updatedAt',
        ])
        && data.formType is string
        && data.formType.size() >= 1
        && data.formType.size() <= 30
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && isTrackingDate(data.dueDate)
        && data.amountDue is number
        && data.amountDue >= 0
        && data.amountDue <= 10000000000
        && data.status in ['upcoming', 'due_soon', 'overdue', 'filed']
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt)
        && optionalString('taxPeriod', 100)
        && optionalTrackingUrl('sourceUrl')
        && optionalString('notes', 1000)
        && optionalTrackingDate('filingDate')
        && optionalString('filingReference', 200)
        && optionalString('filingNotes', 1000)
        && optionalTrackingUrl('evidenceUrl');
    }

    function hasFilingAcknowledgment() {
      let data = request.resource.data;
      return data.keys().hasAll(['filingDate', 'filingReference'])
        && isTrackingDate(data.filingDate)
        && data.filingReference is string
        && data.filingReference.matches('.*[^\\s].*');
    }

    function isValidDeadlineCreate() {
      return isValidDeadline()
        && request.resource.data.keys().hasOnly([
          'formType', 'title', 'dueDate', 'amountDue', 'status', 'createdAt', 'updatedAt',
          'taxPeriod', 'sourceUrl', 'notes', 'filingDate', 'filingReference', 'filingNotes', 'evidenceUrl',
        ])
        && (request.resource.data.status != 'filed' || hasFilingAcknowledgment());
    }

    function isValidDeadlineUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidDeadline()
        && data.createdAt == resource.data.createdAt
        && changed.hasOnly([
          'formType', 'title', 'dueDate', 'amountDue', 'status', 'updatedAt',
          'taxPeriod', 'sourceUrl', 'notes', 'filingDate', 'filingReference', 'filingNotes', 'evidenceUrl',
        ])
        // Preserve legacy filed records; require evidence when a filing is newly recorded or changed.
        && (data.status != 'filed'
          || (resource.data.status == 'filed'
            && !changed.hasAny(['filingDate', 'filingReference', 'filingNotes', 'evidenceUrl']))
          || hasFilingAcknowledgment());
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSupportAdmin();
      allow create: if isOwner(userId) && isValidUserProfileCreate();
      allow update: if isVerifiedOwner(userId) && isValidUserProfileUpdate();
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isVerifiedOwner(userId) || isSupportAdmin();
        allow create: if isVerifiedOwner(userId) && isValidTransactionCreate();
        allow update: if isVerifiedOwner(userId) && isValidTransactionUpdate();
        allow delete: if isVerifiedOwner(userId);
      }

      match /deadlines/{deadlineId} {
        allow read: if isVerifiedOwner(userId) || isSupportAdmin();
        allow create: if isVerifiedOwner(userId) && isValidDeadlineCreate();
        allow update: if isVerifiedOwner(userId) && isValidDeadlineUpdate();
        allow delete: if isVerifiedOwner(userId);
      }

      match /permits/{permitId} {
        allow read: if isVerifiedOwner(userId) || isSupportAdmin();
        allow create, update, delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isVerifiedOwner(userId) || isSupportAdmin();
        allow create, update, delete: if false;
      }
    }
  }
}
